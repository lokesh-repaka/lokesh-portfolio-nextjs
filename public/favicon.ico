<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#141c2e"/>
      <stop offset="100%" stop-color="#060912"/>
    </radialGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a"/>
      <stop offset="50%" stop-color="#eab308"/>
      <stop offset="100%" stop-color="#ca8a04"/>
    </linearGradient>
    <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="1.5" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  <!-- Background Circle with border -->
  <circle cx="32" cy="32" r="30" fill="url(#bgGrad)" stroke="url(#goldGrad)" stroke-width="2.5"/>
  <!-- Inner Ring for high-end crest feel -->
  <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(234, 179, 8, 0.35)" stroke-width="1" stroke-dasharray="3,2"/>
  <!-- Elegant Gold L Monogram -->
  <text x="32" y="44" 
        font-family="'Cinzel', 'Georgia', 'Times New Roman', serif" 
        font-size="34" 
        font-weight="800" 
        text-anchor="middle" 
        fill="url(#goldGrad)" 
        filter="url(#goldGlow)">L</text>
</svg>
